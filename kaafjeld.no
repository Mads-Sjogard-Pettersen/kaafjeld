<!DOCTYPE html>
<html lang="no">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Frode Kaafjeld — Din Taleskriver</title>
<link href="https://fonts.googleapis.com/css2?family=Krona+One&family=Montserrat:wght@200;300;400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --slate-dark:  #4a6278;
  --slate-mid:   #6a8298;
  --slate-light: #8fa8bc;
  --silver:      #b8ccd8;
  --mist:        #d8e6ee;
  --near-white:  #eef4f8;
  --ink:         #1e2e38;
  --ink-mid:     #2e4252;
  --ink-soft:    #4a6070;
  --ink-pale:    #7a9aaa;
  --white-glass: rgba(18,40,58,0.42);
  --white-border:rgba(255,255,255,0.18);
}

html { scroll-behavior: smooth; }

/* ── THE CANVAS: grainy mesh background ── */
body {
  font-family: 'Montserrat', sans-serif;
  font-weight: 300;
  overflow-x: hidden;
  min-height: 100vh;
  /* Base colour */
  background-color: #5a7a8e;
}

/* Grainy mesh canvas — fixed so content scrolls over it */
body::after {
  content: '';
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  /* Soft radial blobs create the depth */
  background-image:
    radial-gradient(ellipse 90%  60% at 12%  8%,  #7a9ab0 0%, transparent 55%),
    radial-gradient(ellipse 70%  50% at 88% 15%,  #5a7e96 0%, transparent 50%),
    radial-gradient(ellipse 80%  55% at 55% 48%,  #6a8898 0%, transparent 52%),
    radial-gradient(ellipse 65%  60% at 18% 72%,  #627888 0%, transparent 52%),
    radial-gradient(ellipse 75%  45% at 82% 85%,  #486070 0%, transparent 50%),
    radial-gradient(ellipse 100% 100% at 50% 50%, #6a8496 0%, transparent 80%);
  animation: meshShift 22s ease-in-out infinite alternate;
}
@keyframes meshShift {
  0%   { opacity: 1;    filter: hue-rotate(0deg)   brightness(1.0);  }
  33%  { opacity: 0.95; filter: hue-rotate(4deg)   brightness(1.04); }
  66%  { opacity: 1.0;  filter: hue-rotate(-3deg)  brightness(0.97); }
  100% { opacity: 0.92; filter: hue-rotate(6deg)   brightness(1.02); }
}

/* Grain overlay — this is the key texture */
body::before {
  content: '';
  position: fixed; inset: 0; z-index: 1; pointer-events: none;
  opacity: 0.38;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='grain'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.72' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23grain)'/%3E%3C/svg%3E");
  background-size: 220px 220px;
  mix-blend-mode: overlay;
}

/* All content sits above grain */
nav, #hero, .page-section, .pull-wrap, .contact-wrap, footer { position: relative; z-index: 2; }

/* ── REVEAL ── */
.r {
  opacity: 0; transform: translateY(20px);
  transition: opacity 0.95s cubic-bezier(0.16,1,0.3,1), transform 0.95s cubic-bezier(0.16,1,0.3,1);
}
.r.on { opacity: 1; transform: none; }
.d1 { transition-delay: 0.1s; }
.d2 { transition-delay: 0.22s; }
.d3 { transition-delay: 0.36s; }
.d4 { transition-delay: 0.52s; }

/* ── GRADIENT TEXT ── */
.gt {
  background: linear-gradient(140deg, #fff 0%, rgba(255,255,255,0.72) 55%, #c2d8e8 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.gt-num {
  background: linear-gradient(160deg, rgba(255,255,255,0.55) 0%, rgba(200,220,235,0.18) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── GLASS ── */
.glass {
  background: var(--white-glass);
  border: 1px solid var(--white-border);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 14px;
}

/* ══ NAV ══ */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  padding: 18px 52px;
}
.nav-pill {
  display: flex; justify-content: space-between; align-items: center;
  background: rgba(255,255,255,0.14);
  border: 1px solid rgba(255,255,255,0.28);
  backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
  border-radius: 100px; padding: 11px 14px 11px 26px;
  transition: background 0.4s;
}
.nav-pill:hover { background: rgba(255,255,255,0.2); }
.nav-name {
  font-family: 'Krona One', sans-serif;
  font-size: 0.72rem; letter-spacing: 0.04em;
  color: white; text-decoration: none;
}
.nav-cta {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.68rem; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(255,255,255,0.8); text-decoration: none;
  background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3);
  padding: 9px 22px; border-radius: 100px;
  transition: background 0.3s, color 0.3s;
}
.nav-cta:hover { background: rgba(255,255,255,0.3); color: white; }

/* ══ HERO ══ */
#hero {
  min-height: 100vh;
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 0 52px 11vh; overflow: hidden;
}

/* Slow-drifting light blobs for depth */
.orb {
  position: absolute; border-radius: 50%; pointer-events: none;
  filter: blur(72px); opacity: 0.28;
}
.o1 { width: 700px; height: 550px; top: -120px; right: -60px;
      background: radial-gradient(circle, #c8dce8, transparent 65%);
      animation: od1 24s ease-in-out infinite alternate; }
.o2 { width: 500px; height: 450px; bottom: 5%; left: -80px;
      background: radial-gradient(circle, #7aa0b8, transparent 65%);
      animation: od2 18s ease-in-out infinite alternate; }
.o3 { width: 350px; height: 350px; top: 42%; left: 42%;
      background: radial-gradient(circle, #b0cad8, transparent 65%);
      animation: od1 28s ease-in-out infinite alternate-reverse; }
@keyframes od1 { 0%{transform:translate(0,0)} 100%{transform:translate(35px,28px)} }
@keyframes od2 { 0%{transform:translate(0,0)} 100%{transform:translate(-28px,-36px)} }

.hero-kicker {
  font-size: 0.6rem; font-weight: 400; letter-spacing: 0.3em; text-transform: uppercase;
  color: rgba(255,255,255,0.48); margin-bottom: 22px;
  opacity: 0; animation: fUp 0.9s 0.3s forwards;
}
.hero-h1 {
  font-family: 'Krona One', sans-serif;
  font-size: clamp(2.4rem, 5.5vw, 4.4rem);
  line-height: 1.14; letter-spacing: -0.01em;
  margin-bottom: 28px;
  opacity: 0; animation: fUp 0.9s 0.55s forwards;
}
.hero-sub {
  font-size: 0.96rem; line-height: 1.86; font-weight: 300;
  color: rgba(255,255,255,0.58);
  max-width: 480px; margin-bottom: 48px;
  opacity: 0; animation: fUp 0.9s 0.8s forwards;
}
.hero-btns {
  display: flex; align-items: center; gap: 14px;
  opacity: 0; animation: fUp 0.9s 1.0s forwards;
}
.btn-solid {
  background: rgba(255,255,255,0.88);
  color: var(--ink); padding: 14px 32px; border-radius: 100px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase;
  text-decoration: none; border: 1px solid rgba(255,255,255,0.95);
  transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
}
.btn-solid:hover { background: white; transform: translateY(-2px); box-shadow: 0 12px 32px rgba(40,70,90,0.22); }
.btn-outline {
  background: transparent; border: 1px solid rgba(255,255,255,0.35);
  color: rgba(255,255,255,0.75); padding: 14px 28px; border-radius: 100px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem; font-weight: 300; letter-spacing: 0.14em; text-transform: uppercase;
  text-decoration: none; backdrop-filter: blur(8px);
  transition: background 0.3s, border-color 0.3s, color 0.3s;
}
.btn-outline:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.6); color: white; }

/* Floating quote card */
.hero-quote-card {
  position: absolute; top: 24%; right: 52px; z-index: 2;
  max-width: 252px; padding: 22px 24px;
  opacity: 0; animation: fUp 1s 1.4s forwards;
}
.stars { display: flex; gap: 3px; margin-bottom: 12px; }
.stars span { font-size: 0.65rem; color: rgba(255,255,255,0.55); }
.hero-quote-card blockquote {
  font-size: 0.85rem; line-height: 1.68; font-weight: 300; font-style: italic;
  color: rgba(255,255,255,0.72);
}
.hero-quote-card cite {
  display: block; margin-top: 12px;
  font-size: 0.6rem; letter-spacing: 0.16em; text-transform: uppercase;
  color: rgba(255,255,255,0.35); font-style: normal;
}

/* Scroll cue */
.scroll-cue {
  position: absolute; bottom: 34px; left: 52px;
  display: flex; align-items: center; gap: 12px;
  opacity: 0; animation: fUp 1s 1.6s forwards;
}
.sc-line { width: 30px; height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.28)); }
.scroll-cue span { font-size: 0.58rem; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(255,255,255,0.28); }

@keyframes fUp { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }

/* ══ PAGE SECTIONS ══ */
.page-section { padding: 96px 52px; }
.inner { max-width: 1040px; margin: 0 auto; }

.lbl {
  font-size: 0.58rem; font-weight: 400; letter-spacing: 0.28em; text-transform: uppercase;
  color: rgba(255,255,255,0.42); display: block; margin-bottom: 14px;
}
.h2 {
  font-family: 'Krona One', sans-serif;
  font-size: clamp(1.6rem, 2.8vw, 2.2rem);
  line-height: 1.22; letter-spacing: -0.01em;
  margin-bottom: 24px;
}
.body {
  font-size: 0.93rem; line-height: 1.9; font-weight: 300;
  color: rgba(255,255,255,0.6); margin-bottom: 16px;
}
.body strong { color: rgba(255,255,255,0.88); font-weight: 400; }
.aside-note {
  margin-top: 18px; font-size: 0.88rem; font-style: italic; font-weight: 300;
  color: rgba(255,255,255,0.32); line-height: 1.65;
}

/* ── PROBLEM GRID ── */
.problem-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 28px; align-items: start;
}
.problem-card { padding: 44px 42px; }

.img-card {
  position: relative; border-radius: 14px; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.22);
  box-shadow: 0 20px 56px rgba(20,50,68,0.22);
}
.img-card img {
  width: 100%; display: block; object-fit: cover;
  filter: saturate(0.72) brightness(0.86);
  transition: filter 0.8s, transform 0.8s;
}
.img-card:hover img { filter: saturate(0.88) brightness(0.93); transform: scale(1.022); }
.img-card::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 48%, rgba(20,44,60,0.5));
}

/* ── PULL QUOTE ── */
.pull-wrap { padding: 0 52px 80px; }
.pull-card {
  max-width: 1040px; margin: 0 auto;
  padding: 52px 60px; text-align: center;
  background: var(--white-glass);
  border: 1px solid var(--white-border);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 14px;
}
.pull-mark {
  font-family: 'Krona One', sans-serif; font-size: 5.5rem; line-height: 0.65;
  display: block; margin-bottom: -12px; user-select: none;
  background: linear-gradient(160deg, rgba(255,255,255,0.35), rgba(255,255,255,0.08));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.pull-card blockquote {
  font-size: clamp(1.3rem, 2.4vw, 1.85rem);
  font-weight: 300; line-height: 1.55; font-style: italic;
  color: rgba(255,255,255,0.8);
}
.pull-card cite {
  display: block; margin-top: 18px;
  font-size: 0.6rem; font-weight: 300; letter-spacing: 0.22em;
  text-transform: uppercase; color: rgba(255,255,255,0.4); font-style: normal;
}

/* ── STEPS ── */
.proc-head {
  display: flex; justify-content: space-between; align-items: flex-end;
  gap: 48px; margin-bottom: 24px; max-width: 1040px; margin-left: auto; margin-right: auto;
}
.proc-head p { max-width: 340px; font-size: 0.92rem; line-height: 1.86; color: rgba(255,255,255,0.52); }

.steps-grid {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 14px; max-width: 1040px; margin: 0 auto;
}
.step-card {
  padding: 30px 26px 34px; position: relative; overflow: hidden;
  transition: transform 0.35s, background 0.35s;
}
.step-card:hover { transform: translateY(-5px); background: rgba(255,255,255,0.22); }
.step-bg-num {
  position: absolute; top: -14px; right: 8px;
  font-family: 'Krona One', sans-serif; font-size: 6.5rem; line-height: 1;
  user-select: none; pointer-events: none;
}
.step-lbl {
  font-size: 0.56rem; font-weight: 400; letter-spacing: 0.28em; text-transform: uppercase;
  color: rgba(255,255,255,0.35); display: block; margin-bottom: 18px;
}
.step-title {
  font-family: 'Krona One', sans-serif;
  font-size: 0.9rem; line-height: 1.4;
  color: rgba(255,255,255,0.88); margin-bottom: 14px;
}
.step-card p { font-size: 0.86rem; line-height: 1.84; color: rgba(255,255,255,0.5); }

/* ── ABOUT ── */
.about-grid {
  display: grid; grid-template-columns: 5fr 7fr;
  gap: 28px; align-items: center; max-width: 1040px; margin: 0 auto;
}
.about-img-card {
  position: relative; border-radius: 14px; overflow: hidden;
  aspect-ratio: 3/4;
  border: 1px solid rgba(255,255,255,0.22);
  box-shadow: 0 24px 60px rgba(20,50,68,0.24);
}
.about-img-card img {
  width: 100%; height: 100%; object-fit: cover;
  filter: saturate(0.68) brightness(0.84);
  transition: filter 0.8s, transform 0.8s;
}
.about-img-card:hover img { filter: saturate(0.84) brightness(0.92); transform: scale(1.02); }
.about-img-card::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent 50%, rgba(20,44,60,0.58));
}
.about-card { padding: 42px 38px; }
.creds { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; }
.cred { display: flex; align-items: center; gap: 14px; font-size: 0.85rem; color: rgba(255,255,255,0.58); }
.cred::before { content:''; flex-shrink:0; width:20px; height:1px; background:rgba(255,255,255,0.3); }

/* ── CONTACT ── */
.contact-wrap { padding: 0 52px 96px; }
.contact-card {
  max-width: 580px; margin: 0 auto;
  padding: 56px 52px 60px; text-align: center;
  background: var(--white-glass);
  border: 1px solid var(--white-border);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 14px;
}
.c-h2 {
  font-family: 'Krona One', sans-serif;
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  line-height: 1.2; margin-bottom: 16px;
  background: linear-gradient(140deg, #fff 0%, rgba(255,255,255,0.72) 55%, #c2d8e8 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.c-body { font-size: 0.93rem; line-height: 1.86; font-weight: 300; color: rgba(255,255,255,0.6); margin-bottom: 38px; }
.contact-card .lbl { color: rgba(255,255,255,0.42); }
.price-note {
  margin-top: 22px; font-size: 0.62rem; font-weight: 300;
  letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.35);
}
.email-btn {
  display: inline-flex; align-items: center; gap: 12px;
  background: rgba(255,255,255,0.9); color: var(--ink);
  padding: 15px 36px; border-radius: 100px;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.92rem; font-weight: 400; letter-spacing: 0.02em;
  text-decoration: none;
  transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
  box-shadow: 0 8px 30px rgba(20,50,68,0.2);
}
.email-btn:hover { background: white; transform: translateY(-2px); box-shadow: 0 16px 44px rgba(20,50,68,0.3); }
.price-note {
  margin-top: 22px; font-size: 0.62rem; font-weight: 300;
  letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-pale);
}

/* ── FOOTER ── */
footer {
  border-top: 1px solid rgba(255,255,255,0.12);
  padding: 22px 52px;
  display: flex; justify-content: space-between; align-items: center;
  background: rgba(20,44,60,0.12); backdrop-filter: blur(10px);
}
footer span { font-size: 0.64rem; letter-spacing: 0.08em; color: rgba(255,255,255,0.22); }
footer a { font-size: 0.64rem; letter-spacing: 0.08em; color: rgba(255,255,255,0.3); text-decoration: none; transition: color 0.3s; }
footer a:hover { color: rgba(255,255,255,0.75); }

/* ── MOBILE ── */
@media (max-width: 820px) {
  nav { padding: 14px 18px; }
  #hero { padding: 0 22px 80px; }
  .hero-quote-card { display: none; }
  .scroll-cue { left: 22px; }
  .page-section { padding: 68px 22px; }
  .pull-wrap, .contact-wrap { padding: 0 22px 60px; }
  .pull-card, .contact-card { padding: 36px 24px; }
  .problem-grid { grid-template-columns: 1fr; }
  .steps-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  .about-grid { grid-template-columns: 1fr; }
  .about-img-card { aspect-ratio: 4/3; }
  .proc-head { flex-direction: column; align-items: flex-start; gap: 14px; }
  footer { flex-direction: column; gap: 10px; padding: 18px 22px; text-align: center; }
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-pill">
    <a href="#" class="nav-name">Frode Kaafjeld</a>
    <a href="mailto:frode@kaafjeld.no" class="nav-cta">Ta kontakt</a>
  </div>
</nav>

<!-- ══ HERO ══ -->
<section id="hero">
  <div class="orb o1"></div>
  <div class="orb o2"></div>
  <div class="orb o3"></div>

  <div class="hero-quote-card glass">
    <div class="stars"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
    <blockquote>«Fantastisk bra! Nå forsvant 1000 kilo av skuldrene mine.»</blockquote>
    <cite>— fornøyd klient</cite>
  </div>

  <p class="hero-kicker">Frode Kaafjeld — Din taleskriver</p>
  <h1 class="hero-h1 gt">Får du hjerteklapp<br>bare ved tanken?</h1>
  <p class="hero-sub">Du skal holde en tale, men er usikker på hvordan du skal gripe det an. Få profesjonell hjelp fra noen med lang erfaring i å skrive alle typer taler.</p>
  <div class="hero-btns">
    <a href="mailto:frode@kaafjeld.no" class="btn-solid">Send forespørsel</a>
    <a href="#prosess" class="btn-outline">Slik gjør vi det</a>
  </div>

  <div class="scroll-cue">
    <div class="sc-line"></div>
    <span>Scroll</span>
  </div>
</section>

<!-- ══ PROBLEM ══ -->
<div class="page-section" id="problem">
  <div class="inner">
    <div class="problem-grid">
      <div class="glass problem-card r">
        <span class="lbl">Kjenner du deg igjen?</span>
        <h2 class="h2 gt r d1">Du skal holde en tale — men det knyter seg.</h2>
        <p class="body r d2">Du skal holde en tale om noen timer, dager eller uker, men er usikker på hvordan du skal gripe det an. Kanskje har du gjort noen forsøk på å komme i gang, men så knyter det seg. Eller du har poengene, men får ikke til å sy dem sammen og skape flyt.</p>
        <p class="body r d2">ChatGPT? Nyttig, men «den» er ikke tankeleser. AI-modellen kan ikke lokke frem de små episodene som gjør talen din personlig og løfter den fra «ok» til <strong>«den glemmer jeg aldri»</strong>.</p>
        <p class="body r d3">Profesjonell hjelp fra noen med lang erfaring i å skrive alle typer taler — til jubileer, bryllup, merkedager og store profesjonelle anledninger.</p>
        <p class="aside-note r d3">[Og ingen får vite at du har fått litt hjelp underveis]</p>
      </div>
      <div class="img-card r d1">
        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=700&q=75"
             alt="Frode Kaafjeld" style="aspect-ratio:3/4; max-height:580px;">
      </div>
    </div>
  </div>
</div>

<!-- ══ PULL QUOTE ══ -->
<div class="pull-wrap">
  <div class="pull-card r">
    <span class="pull-mark">"</span>
    <blockquote>Fantastisk bra! Nå forsvant 1000 kilo av skuldrene mine.</blockquote>
    <cite>— fornøyd klient</cite>
  </div>
</div>

<!-- ══ PROCESS ══ -->
<div class="page-section" id="prosess">
  <div class="proc-head">
    <div>
      <span class="lbl r">Slik gjør vi det</span>
      <h2 class="h2 gt r d1">Sammen lager vi<br>talen din</h2>
    </div>
    <p class="r d2">Du er kilden til innholdet. Du skal føle at talen er 100 prosent din. Jeg hjelper bare med å få frem det du har på hjertet.</p>
  </div>
  <div class="steps-grid">
    <div class="glass step-card r">
      <span class="step-bg-num gt-num">01</span>
      <span class="step-lbl">Steg 01</span>
      <p class="step-title">Samtale</p>
      <p>Vi tar en samtale på telefon hvor jeg stiller de spørsmålene som trengs. Eventuelt går vi gjennom stikkord og utkastet du allerede har skrevet.</p>
    </div>
    <div class="glass step-card r d1">
      <span class="step-bg-num gt-num">02</span>
      <span class="step-lbl">Steg 02</span>
      <p class="step-title">Jobben begynner</p>
      <p>Jeg går i gang, og hvis jeg lurer på noe eller trenger flere detaljer, ber jeg deg om input.</p>
    </div>
    <div class="glass step-card r d2">
      <span class="step-bg-num gt-num">03</span>
      <span class="step-lbl">Steg 03</span>
      <p class="step-title">Første utkast</p>
      <p>Du får første utkast til gjennomlesning og kommer med dine kommentarer.</p>
    </div>
    <div class="glass step-card r d3">
      <span class="step-bg-num gt-num">04</span>
      <span class="step-lbl">Steg 04</span>
      <p class="step-title">Ferdig</p>
      <p>Vi holder på til du er 100% trygg på talen. Så får du tips til fremføringen. Vi snakkes!</p>
    </div>
  </div>
</div>

<!-- ══ ABOUT ══ -->
<div class="page-section">
  <div class="about-grid">
    <div class="about-img-card r">
      <img src="frode.webp" alt="Frode Kaafjeld">
    </div>
    <div class="glass about-card r d1">
      <span class="lbl">Om Frode</span>
      <h2 class="h2 gt r d2">Frode Kaafjeld,<br>din personlige<br>taleskriver</h2>
      <p class="body r d2">Har mange år bak meg i kommunikasjonsbransjen som tekstforfatter, journalist, rådgiver og forfatter av bøker.</p>
      <p class="body r d3">Lang erfaring med alle typer taler, både for små og store anledninger. Ydmyk og beæret for å få lov til å hjelpe deg med din tale!</p>
      <div class="creds r d3">
        <div class="cred">Tekstforfatter, journalist & rådgiver</div>
        <div class="cred">Forfatter av bøker</div>
        <div class="cred">Alle typer taler — store og små</div>
        <div class="cred">Pris fra kr. 1 500,–</div>
      </div>
    </div>
  </div>
</div>

<!-- ══ CONTACT ══ -->
<div class="contact-wrap">
  <div class="contact-card r">
    <span class="lbl" style="display:block;text-align:center;margin-bottom:14px;">Ta kontakt</span>
    <h2 class="c-h2 gt r d1">Du trenger ikke<br>flere søvnløse netter.</h2>
    <p class="c-body r d2">Legg igjen din kontaktinformasjon og skriv noen ord om hva du trenger hjelp til, så hører du fra meg!</p>
    <div class="r d3">
      <a href="mailto:frode@kaafjeld.no" class="email-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
        frode@kaafjeld.no
      </a>
    </div>
    <p class="price-note r d4">Fra kr. 1 500,– · Svar innen 24 timer</p>
  </div>
</div>

<footer>
  <span>© 2026 Frode Kaafjeld — Din taleskriver</span>
  <a href="mailto:frode@kaafjeld.no">frode@kaafjeld.no</a>
</footer>

<script>
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('on'); });
}, { threshold: 0.06, rootMargin: '0px 0px -18px 0px' });
document.querySelectorAll('.r').forEach(el => obs.observe(el));
</script>
</body>
</html>
